<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LifeManagementApp.Views.TodoPage">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Tehtävälista"
            FontSize="24"
            FontAttributes="Bold" />

        <Entry
            Placeholder="Kirjoita uusi tehtävä"
            Text="{Binding NewTodoTitle}" />

        <Button
            Text="Lisää tehtävä"
            Command="{Binding AddTodoCommand}" />

        <CollectionView
            ItemsSource="{Binding Todos}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="0,5">

                        <Label
                            Text="{Binding Title}" />

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>