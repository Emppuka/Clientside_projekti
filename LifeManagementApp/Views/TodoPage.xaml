<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LifeManagementApp.Views.TodoPage">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Tehtävälista"
            FontSize="24"
            FontAttributes="Bold" />

        <Entry
            Placeholder="Kirjoita uusi tehtävä"
            Text="{Binding NewTodoTitle}" />

        <Picker
        Title="Valitse tärkeys"
        SelectedIndex="{Binding SelectedPriority}">

            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Korkea</x:String>
                    <x:String>Normaali</x:String>
                    <x:String>Matala</x:String>
                </x:Array>
            </Picker.ItemsSource>

        </Picker>

        <Button
            Text="Lisää tehtävä"
            Command="{Binding AddTodoCommand}" />

        <CollectionView
            ItemsSource="{Binding Todos}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="0,5">

                        <VerticalStackLayout>

                            <Label
                            Text="{Binding Title}"
                            FontAttributes="Bold" />

                            <Label
                            Text="{Binding PriorityText,
                            StringFormat='Tärkeys: {0}'}"
                            FontSize="12" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>