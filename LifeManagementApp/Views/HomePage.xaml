<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LifeManagementApp.Views.HomePage">

    <ScrollView>

        <VerticalStackLayout
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            Padding="20"
            Spacing="15">

            <Label
                Text="Elämänhallinta-äppsi"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
    Text="Kolme tärkeintä tehtävää"
    FontSize="20"
    FontAttributes="Bold" />

            <CollectionView
    ItemsSource="{Binding TopTodos}"
    HeightRequest="150">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame Margin="0,5">

                            <Label
                    Text="{Binding Title}" />

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Sää nyt"
                FontSize="24" />

            <Frame Padding="15">

                <VerticalStackLayout>

                    <Label
                        Text="{Binding Temperature,
                        StringFormat='Lämpötila: {0} °C'}" />

                    <Label
                        Text="{Binding WindSpeed,
                        StringFormat='Tuulen nopeus: {0} m/s'}" />

                    <Label
                        Text="{Binding KiteMessage}"
                        TextColor="Green" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>